{
  "name": "restaurant-sim",
  "private": true,
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "dev:api": "pnpm --filter @restaurant-sim/api dev",
    "dev:web": "pnpm --filter @restaurant-sim/observer dev"
  }
}
